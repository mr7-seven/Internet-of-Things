    {
        "id": "8c33a7bd766b5b30",
        "type": "ui-template",
        "z": "cab6f378c1142eb1",
        "group": "f61b53563b5576bf",
        "page": "",
        "ui": "",
        "name": "ID",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n    <div class=\"profil-container\">\n\n        <!-- Bagian kiri: foto -->\n        <div class=\"profil-foto\">\n            <img\n                src=\"/images/foto.png\"\n                alt=\"Foto\"\n            >\n        </div>\n\n        <!-- Bagian kanan: identitas -->\n        <div class=\"profil-data\">\n\n            <div class=\"data-row\">\n                <span class=\"label\">Nama</span>\n                <span class=\"colon\">:</span>\n                <span class=\"value\">Nama Lengkap</span>\n            </div>\n\n            <div class=\"data-row\">\n                <span class=\"label\">NIM</span>\n                <span class=\"colon\">:</span>\n                <span class=\"value\">123456789</span>\n            </div>\n\n            <div class=\"data-row\">\n                <span class=\"label\">Kelas</span>\n                <span class=\"colon\">:</span>\n                <span class=\"value\">TI-3A</span>\n            </div>\n\n        </div>\n\n    </div>\n</template>\n\n<style>\n.profil-container {\n    width: 100%;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    gap: 25px;\n\n    padding: 15px;\n    box-sizing: border-box;\n}\n\n/* FOTO */\n.profil-foto {\n    flex: 0 0 130px;\n\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.profil-foto img {\n    width: 120px;\n    height: 150px;\n\n    object-fit: cover;\n\n    border-radius: 10px;\n}\n\n/* DATA IDENTITAS */\n.profil-data {\n    flex: 1;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n\n    gap: 12px;\n}\n\n/* Setiap baris */\n.data-row {\n    display: flex;\n    align-items: center;\n\n    font-size: 18px;\n    line-height: 1.5;\n}\n\n/* Nama, NIM, Kelas */\n.label {\n    flex: 0 0 65px;\n    font-weight: 600;\n}\n\n/* Titik dua */\n.colon {\n    flex: 0 0 20px;\n    font-weight: 600;\n}\n\n/* Nilai */\n.value {\n    flex: 1;\n}\n\n/* Responsive */\n@media (max-width: 500px) {\n    .profil-container {\n        flex-direction: column;\n        text-align: left;\n    }\n\n    .profil-foto {\n        flex: none;\n    }\n\n    .profil-data {\n        width: 100%;\n    }\n}\n</style>",
