    {
        "id": "21e7979b45f4f919",
        "type": "ui-template",
        "z": "7985609579c75d70",
        "group": "826197a87de983b0",
        "page": "",
        "ui": "",
        "name": "LED PWM",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div class=\"traffic-container\">\n        <div v-for=\"light in lights\" :key=\"light.id\" class=\"traffic-card\">\n            <div class=\"traffic-title\">\n                {{ light.label }}\n            </div>\n\n            <div class=\"traffic-lamp\" :style=\"lampStyle(light)\"></div>\n\n            <div class=\"traffic-status\" :class=\"{ active: light.on }\">\n                {{ light.on ? \"ON\" : \"OFF\" }}\n            </div>\n\n            <label class=\"traffic-switch\">\n                <input\n                    type=\"checkbox\"\n                    :checked=\"light.on\"\n                    @change=\"toggleLight(light, $event)\"\n                >\n\n                <span class=\"switch-track\">\n                    <span class=\"switch-thumb\"></span>\n                </span>\n            </label>\n\n            <div class=\"pwm-value\">\n                <span>PWM</span>\n                <strong>{{ light.pwm }}</strong>\n            </div>\n\n            <input\n                class=\"pwm-slider\"\n                type=\"range\"\n                min=\"0\"\n                max=\"255\"\n                step=\"1\"\n                :value=\"light.pwm\"\n                :style=\"{ accentColor: light.color }\"\n                @input=\"updatePwm(light, $event)\"\n                @change=\"sendLight(light)\"\n            >\n        </div>\n    </div>\n</template>\n\n<script>\n    export default {\n    data() {\n        return {\n            // Ganti dengan NIM yang sama seperti program ESP32\n            mqttTopic: \"data/iot/actuator/12345\",\n\n            lights: [\n                {\n                    id: \"red\",\n                    label: \"R\",\n                    color: \"#ef4444\",\n                    on: false,\n                    pwm: 255\n                },\n                {\n                    id: \"yellow\",\n                    label: \"Y\",\n                    color: \"#facc15\",\n                    on: false,\n                    pwm: 255\n                },\n                {\n                    id: \"green\",\n                    label: \"G\",\n                    color: \"#22c55e\",\n                    on: false,\n                    pwm: 255\n                }\n            ]\n        }\n    },\n\n    methods: {\n        updatePwm(light, event) {\n            // Hanya memperbarui tampilan saat slider bergerak\n            light.pwm = Number(event.target.value)\n        },\n\n        toggleLight(light, event) {\n            light.on = event.target.checked\n            this.sendLight(light)\n        },\n\n        sendLight(light) {\n            const data = {\n                led: light.id,\n                state: light.on ? \"ON\" : \"OFF\",\n                pwm: light.on ? light.pwm : 0\n            }\n\n            this.send({\n                topic: this.mqttTopic,\n                payload: JSON.stringify(data)\n            })\n        },\n\n        lampStyle(light) {\n            const intensity = light.on\n                ? Math.max(light.pwm, 10) / 255\n                : 0\n\n            return {\n                backgroundColor: light.on\n                    ? light.color\n                    : \"#374151\",\n\n                opacity: light.on\n                    ? 0.4 + (intensity * 0.6)\n                    : 0.25,\n\n                boxShadow: light.on\n                    ? `0 0 ${10 + intensity * 25}px ${light.color}`\n                    : \"none\"\n            }\n        }\n    }\n}\n</script>\n\n<style>\n    .traffic-container {\n        width: 100%;\n        display: flex;\n        flex-wrap: wrap;\n        align-items: stretch;\n        justify-content: center;\n        gap: 16px;\n        box-sizing: border-box;\n    }\n\n    .traffic-card {\n        flex: 1 1 160px;\n        min-width: 150px;\n        max-width: 230px;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        gap: 13px;\n        padding: 20px 16px;\n        border-radius: 16px;\n        box-sizing: border-box;\n        background: rgb(var(--v-theme-surface));\n        color: rgb(var(--v-theme-on-surface));\n        border: 1px solid rgba(var(--v-theme-on-surface), 0.12);\n        box-shadow: 0 5px 16px rgba(0, 0, 0, 0.12);\n    }\n\n    .traffic-title {\n        font-size: 16px;\n        font-weight: 700;\n        letter-spacing: 1px;\n    }\n\n    .traffic-lamp {\n        width: 72px;\n        height: 72px;\n        border: 5px solid #1f2937;\n        border-radius: 50%;\n        transition:\n            background-color 0.25s,\n            box-shadow 0.25s,\n            opacity 0.25s;\n    }\n\n    .traffic-status {\n        min-width: 54px;\n        padding: 4px 12px;\n        border-radius: 20px;\n        background: #6b7280;\n        color: #ffffff;\n        font-size: 13px;\n        font-weight: 700;\n        text-align: center;\n    }\n\n    .traffic-status.active {\n        background: #2563eb;\n    }\n\n    .traffic-switch {\n        display: inline-flex;\n        cursor: pointer;\n        user-select: none;\n    }\n\n    .traffic-switch input {\n        position: absolute;\n        opacity: 0;\n        pointer-events: none;\n    }\n\n    .switch-track {\n        position: relative;\n        width: 52px;\n        height: 28px;\n        border-radius: 30px;\n        background: #9ca3af;\n        transition: background 0.25s;\n    }\n\n    .switch-thumb {\n        position: absolute;\n        top: 3px;\n        left: 3px;\n        width: 22px;\n        height: 22px;\n        border-radius: 50%;\n        background: #ffffff;\n        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);\n        transition: transform 0.25s;\n    }\n\n    .traffic-switch input:checked+.switch-track {\n        background: #2563eb;\n    }\n\n    .traffic-switch input:checked+.switch-track .switch-thumb {\n        transform: translateX(24px);\n    }\n\n    .pwm-value {\n        width: 100%;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        font-size: 14px;\n    }\n\n    .pwm-value strong {\n        min-width: 48px;\n        padding: 4px 8px;\n        border-radius: 8px;\n        background: rgba(var(--v-theme-on-surface), 0.08);\n        text-align: center;\n        font-size: 16px;\n    }\n\n    .pwm-slider {\n        width: 100%;\n        cursor: pointer;\n    }\n\n    @media (max-width: 600px) {\n        .traffic-container {\n            flex-direction: column;\n        }\n\n        .traffic-card {\n            width: 100%;\n            max-width: none;\n        }\n    }\n</style>",
