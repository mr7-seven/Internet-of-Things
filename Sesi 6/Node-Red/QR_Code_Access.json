        "name": "QR Access UI",
        "order": 1,
        "width": "12",
        "height": "10",
        "head": "",
        "format": "<template>\n  <div class=\"qrac-shell\">\n    <header class=\"qrac-header\">\n      <div>\n        <h2>QR Access Control</h2>\n        <p>Pemindai kartu mahasiswa berbasis <i>Internet of Things</i></p>\n      </div>\n      <div class=\"qrac-nav\">\n        <button :class=\"{ active: page === 'scan' }\" @click=\"showPage('scan')\">\n          Scan Akses\n        </button>\n        <button :class=\"{ active: page === 'register' }\" @click=\"showPage('register')\">\n          Registrasi\n        </button>\n      </div>\n    </header>\n    <main v-if=\"page === 'scan'\" class=\"qrac-scan-layout\">\n      <section class=\"qrac-card\">\n        <div class=\"qrac-section-title\">\n          <div>\n            <h3>Pemindai QR Code</h3>\n            <p>Arahkan QR kartu ke kamera</p>\n          </div>\n          <span class=\"qrac-camera-state\" :class=\"{ active: scannerActive }\">\n            {{ scannerActive ? 'KAMERA AKTIF' : 'KAMERA NONAKTIF' }}\n          </span>\n        </div>\n        <div class=\"qrac-reader-stage\">\n          <div id=\"qr-access-reader\" class=\"qrac-reader\" v-once></div>\n          <div v-if=\"!scannerActive\" class=\"qrac-reader-placeholder\">\n            <span class=\"qrac-camera-icon\">▣</span>\n            <p v-if=\"cameraError\" class=\"qrac-camera-error\">{{ cameraError }}</p>\n            <p v-else>{{ scannerStarting ? 'Membuka kamera...' : 'Tekan tombol Scan untuk membuka webcam' }}</p>\n          </div>\n        </div>\n        <div class=\"qrac-actions\">\n          <button type=\"button\" class=\"qrac-button primary\" :disabled=\"scannerActive || scannerStarting\" @click=\"startScanner\">\n            {{ scannerStarting ? 'Membuka...' : 'Scan' }}\n          </button>\n          <button\n            type=\"button\"\n            class=\"qrac-button danger\"\n            :disabled=\"!scannerAvailable && !scannerActive && !scannerStarting\"\n            @click.stop.prevent=\"stopScanner\">\n            Tutup\n          </button>\n        </div>\n      </section>\n      <aside class=\"qrac-card qrac-status-card\" :class=\"accessClass\">\n        <div class=\"qrac-status-label\">STATUS AKSES</div>\n        <div class=\"qrac-status-value\">{{ accessStatus }}</div>\n        <img class=\"qrac-profile-photo\" :src=\"accessUser.photo || unknownPhoto\" alt=\"Foto pengguna\">\n        <div class=\"qrac-profile-data\">\n          <div>\n            <span>Nama</span>\n            <strong>{{ accessUser.name || 'Unknown' }}</strong>\n          </div>\n          <div>\n            <span>NIM</span>\n            <strong>{{ accessUser.nim || '-' }}</strong>\n          </div>\n          <div>\n            <span>Kelas</span>\n            <strong>{{ accessUser.className || '-' }}</strong>\n          </div>\n        </div>\n      </aside>\n    </main>\n    <main v-else class=\"qrac-register-layout\">\n      <section class=\"qrac-card\">\n        <div class=\"qrac-section-title\">\n          <div>\n            <h3>Registrasi Mahasiswa</h3>\n            <p>QR token dibuat otomatis dari NIM dan nilai acak</p>\n          </div>\n        </div>\n        <form class=\"qrac-form\" @submit.prevent=\"registerStudent\">\n          <label>\n            <span>Nama lengkap</span>\n            <input v-model.trim=\"form.name\" required maxlength=\"80\" placeholder=\"Nama mahasiswa\">\n          </label>\n          <label>\n            <span>NIM</span>\n            <input v-model.trim=\"form.nim\" required maxlength=\"30\" placeholder=\"Contoh: C020321001\">\n          </label>\n          <label>\n            <span>Kelas</span>\n            <input v-model.trim=\"form.className\" required maxlength=\"40\" placeholder=\"Contoh: 3A Elektro\">\n          </label>\n          <label>\n            <span>Foto</span>\n            <input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" @change=\"selectPhoto\">\n          </label>\n          <div class=\"qrac-photo-preview-wrap\">\n            <img class=\"qrac-photo-preview\" :src=\"form.photo || unknownPhoto\" alt=\"Pratinjau foto\">\n            <small>Foto otomatis diperkecil sebelum disimpan ke SQLite.</small>\n          </div>\n          <label>\n            <span>Logo kartu (opsional)</span>\n            <input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" @change=\"selectLogo\">\n          </label>\n          <div v-if=\"form.logo\" class=\"qrac-logo-preview-wrap\">\n            <img class=\"qrac-logo-preview\" :src=\"form.logo\" alt=\"Pratinjau logo\">\n            <button type=\"button\" class=\"qrac-button danger\" @click=\"form.logo = ''\">Hapus Logo</button>\n          </div>\n          <button type=\"submit\" class=\"qrac-button primary full\" :disabled=\"registering\">\n            {{ registering ? 'Menyimpan...' : 'Daftarkan dan Buat Kartu' }}\n          </button>\n        </form>\n      </section>\n      <aside class=\"qrac-card qrac-card-preview\">\n        <div v-if=\"registeredStudent\" class=\"qrac-card-result\">\n          <h3>Kartu Berhasil Dibuat</h3>\n          <div class=\"qrac-student-card\">\n            <div class=\"qrac-student-card-head\">\n              <img v-if=\"registeredStudent.logo\" class=\"qrac-campus-logo\" :src=\"registeredStudent.logo\" alt=\"Logo kampus\">\n              <div v-else class=\"qrac-campus-mark\">AC</div>\n              <div>\n                <strong>KARTU MAHASISWA</strong>\n                <small>IoT Access Control Card</small>\n              </div>\n            </div>\n            <img class=\"qrac-card-photo\" :src=\"registeredStudent.photo || unknownPhoto\" alt=\"Foto mahasiswa\">\n            <div class=\"qrac-card-identity\">\n              <strong>{{ registeredStudent.name }}</strong>\n              <span>{{ registeredStudent.nim }}</span>\n              <small>{{ registeredStudent.className }}</small>\n            </div>\n            <div class=\"qrac-card-qr-wrap\">\n              <img class=\"qrac-generated-qr\" :src=\"registeredStudent.qrImage\" alt=\"QR mahasiswa\">\n              <small>SCAN UNTUK AKSES</small>\n            </div>\n            <div class=\"qrac-card-footer\">IDENTITAS DIGITAL MAHASISWA</div>\n          </div>\n          <button type=\"button\" class=\"qrac-button success full\" @click=\"downloadCard\">\n            Download Kartu PNG\n          </button>\n        </div>\n        <div v-else class=\"qrac-empty-card\">\n          <span>▦</span>\n          <p>Kartu akan muncul setelah registrasi berhasil.</p>\n        </div>\n        <canvas ref=\"cardCanvas\" width=\"720\" height=\"1100\" hidden></canvas>\n      </aside>\n    </main>\n  </div>\n</template>\n<script src=\"https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js\"></script>\n<script>\n  export default {\n  data() {\n    const unknownSvg = `\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"500\" viewBox=\"0 0 400 500\">\n        <rect width=\"400\" height=\"500\" fill=\"#e5e7eb\"/>\n        <circle cx=\"200\" cy=\"170\" r=\"78\" fill=\"#9ca3af\"/>\n        <path d=\"M70 455c8-112 57-170 130-170s122 58 130 170\" fill=\"#9ca3af\"/>\n        <text x=\"200\" y=\"485\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"24\" fill=\"#4b5563\">UNKNOWN</text>\n      </svg>`\n    return {\n      page: 'scan',\n      scannerAvailable: false,\n      scannerSession: 0,\n      scannerStore: Object.freeze({ slots: [null] }),\n      scannerActive: false,\n      scannerStarting: false,\n      scannerStopRequested: false,\n      cameraError: '',\n      scanLocked: false,\n      scanRequestPending: false,\n      lastScannedToken: '',\n      lastScannedAt: 0,\n      scanCooldownTimer: null,\n      scanRequestTimer: null,\n      registerTimer: null,\n      registering: false,\n      accessStatus: 'MENUNGGU',\n      accessUser: {},\n      activeAccessEventId: '',\n      form: {\n        name: '',\n        nim: '',\n        className: '',\n        photo: '',\n        logo: ''\n      },\n      registeredStudent: null,\n      unknownPhoto: `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(unknownSvg)}`,\n      grantedAudioUrl: '/audio/access-granted.mp3',\n      deniedAudioUrl: '/audio/access-denied.mp3',\n      backendMessage: null\n    }\n  },\n  computed: {\n    accessClass() {\n      if (this.accessStatus === 'GRANTED') return 'granted'\n      if (this.accessStatus === 'DENIED') return 'denied'\n      return 'idle'\n    }\n  },\n  methods: {\n    async showPage(target) {\n      if (target === this.page) return\n      if (target === 'register') await this.stopScanner()\n      this.page = target\n    },\n    async waitForLibrary(name, timeoutMs = 8000) {\n      const started = Date.now()\n      while (!window[name] && Date.now() - started < timeoutMs) {\n        await new Promise(resolve => setTimeout(resolve, 100))\n      }\n      return Boolean(window[name])\n    },\n    async startScanner() {\n      if (this.scannerActive || this.scannerStarting) return\n      this.scannerStarting = true\n      this.scannerStopRequested = false\n      this.cameraError = ''\n      const session = ++this.scannerSession\n      let scanner = null\n      if (!window.isSecureContext && location.hostname !== 'localhost') {\n        this.scannerStarting = false\n        this.cameraError = 'Gunakan HTTPS atau localhost agar kamera dapat dibuka.'\n        this.showAlert('error', 'Kamera tidak tersedia', 'Dashboard harus dibuka melalui HTTPS atau localhost.')\n        return\n      }\n      if (!(await this.waitForLibrary('Html5Qrcode'))) {\n        this.scannerStarting = false\n        this.cameraError = 'Library pemindai QR gagal dimuat.'\n        this.showAlert('error', 'Library gagal dimuat', 'Periksa koneksi internet atau akses CDN.')\n        return\n      }\n      try {\n        scanner = new Html5Qrcode('qr-access-reader')\n        this.scannerStore.slots[0] = scanner\n        this.scannerAvailable = true\n        const scanConfig = { fps: 8, qrbox: { width: 190, height: 190 } }\n        try {\n          await scanner.start(\n            { facingMode: { ideal: 'environment' } },\n            scanConfig,\n            this.onQrDetected,\n            () => {}\n          )\n        } catch (primaryError) {\n          try { scanner.clear() } catch (_) {}\n          if (this.scannerStopRequested || session !== this.scannerSession) {\n            throw new Error('SCAN_CANCELLED')\n          }\n          const cameras = await Html5Qrcode.getCameras()\n          if (!cameras.length) throw primaryError\n          scanner = new Html5Qrcode('qr-access-reader')\n          this.scannerStore.slots[0] = scanner\n          this.scannerAvailable = true\n          await scanner.start(\n            cameras[0].id,\n            scanConfig,\n            this.onQrDetected,\n            () => {}\n          )\n        }\n        if (this.scannerStopRequested || session !== this.scannerSession) {\n          try { await scanner.stop() } catch (_) {}\n          try { scanner.clear() } catch (_) {}\n          this.scannerStore.slots[0] = null\n          this.scannerAvailable = false\n          this.scannerStarting = false\n          this.scannerActive = false\n          return\n        }\n        this.scannerStarting = false\n        this.scannerActive = true\n        this.cameraError = ''\n        this.scanLocked = false\n        this.scanRequestPending = false\n      } catch (error) {\n        if (scanner) {\n          try { await scanner.stop() } catch (_) {}\n          try { scanner.clear() } catch (_) {}\n        }\n        this.scannerStarting = false\n        if (session === this.scannerSession) {\n          this.scannerStore.slots[0] = null\n          this.scannerAvailable = false\n        }\n        this.scannerActive = false\n        if (this.scannerStopRequested || error?.message === 'SCAN_CANCELLED') return\n        this.cameraError = error?.message || String(error || 'Izin kamera ditolak.')\n        this.showAlert('error', 'Webcam gagal dibuka', this.cameraError)\n      }\n    },\n    async stopScanner() {\n      this.scannerStopRequested = true\n      this.scannerSession += 1\n      const scanner = this.scannerStore.slots[0]\n      this.scannerStore.slots[0] = null\n      this.scannerAvailable = false\n      this.scannerActive = false\n      this.cameraError = ''\n      this.scanLocked = false\n      this.scanRequestPending = false\n      clearTimeout(this.scanCooldownTimer)\n      clearTimeout(this.scanRequestTimer)\n      if (!scanner) return\n      try {\n        await scanner.stop()\n      } catch (_) {\n      }\n      try {\n        scanner.clear()\n      } catch (_) {\n      }\n    },\n    onQrDetected(decodedText) {\n      const token = String(decodedText || '').trim()\n      const now = Date.now()\n      if (!token || this.scanLocked || this.scanRequestPending) return\n      if (token === this.lastScannedToken && now - this.lastScannedAt < 6000) return\n      this.scanLocked = true\n      this.scanRequestPending = true\n      this.lastScannedToken = token\n      this.lastScannedAt = now\n      this.activeAccessEventId = ''\n      this.accessStatus = 'MEMERIKSA'\n      this.accessUser = {}\n      this.send({\n        payload: {\n          action: 'scan',\n          token\n        }\n      })\n      clearTimeout(this.scanRequestTimer)\n      this.scanRequestTimer = setTimeout(() => {\n        if (!this.scanRequestPending) return\n        this.scanRequestPending = false\n        this.releaseScanner(0)\n        this.accessStatus = 'ERROR'\n        this.showAlert('error', 'Pemeriksaan gagal', 'Node-RED tidak memberikan respons dalam 10 detik.')\n      }, 10000)\n    },\n    releaseScanner(delay = 2200) {\n      clearTimeout(this.scanCooldownTimer)\n      this.scanCooldownTimer = setTimeout(() => {\n        this.scanLocked = false\n      }, delay)\n    },\n    async selectPhoto(event) {\n      const file = event.target.files?.[0]\n      if (!file) return\n      if (file.size > 5 * 1024 * 1024) {\n        this.showAlert('warning', 'Foto terlalu besar', 'Gunakan file foto maksimum 5 MB.')\n        event.target.value = ''\n        return\n      }\n      try {\n        this.form.photo = await this.resizePhoto(file, 320, 400)\n      } catch (_) {\n        this.showAlert('error', 'Foto gagal dibaca', 'Pilih file JPG, PNG, atau WebP yang valid.')\n      }\n    },\n    async selectLogo(event) {\n      const file = event.target.files?.[0]\n      if (!file) return\n      if (file.size > 3 * 1024 * 1024) {\n        this.showAlert('warning', 'Logo terlalu besar', 'Gunakan file logo maksimum 3 MB.')\n        event.target.value = ''\n        return\n      }\n      try {\n        this.form.logo = await this.resizePhoto(file, 256, 256, 'image/png', 0.92)\n      } catch (_) {\n        this.showAlert('error', 'Logo gagal dibaca', 'Pilih file JPG, PNG, atau WebP yang valid.')\n      }\n    },\n    resizePhoto(file, width, height, outputType = 'image/jpeg', quality = 0.78) {\n      return new Promise((resolve, reject) => {\n        const reader = new FileReader()\n        reader.onerror = reject\n        reader.onload = () => {\n          const image = new Image()\n          image.onerror = reject\n          image.onload = () => {\n            const canvas = document.createElement('canvas')\n            const context = canvas.getContext('2d')\n            const scale = Math.max(width / image.width, height / image.height)\n            const drawWidth = image.width * scale\n            const drawHeight = image.height * scale\n            canvas.width = width\n            canvas.height = height\n            context.drawImage(\n              image,\n              (width - drawWidth) / 2,\n              (height - drawHeight) / 2,\n              drawWidth,\n              drawHeight\n            )\n            resolve(canvas.toDataURL(outputType, quality))\n          }\n          image.src = reader.result\n        }\n        reader.readAsDataURL(file)\n      })\n    },\n    registerStudent() {\n      if (this.registering) return\n      if (!this.form.name || !this.form.nim || !this.form.className) {\n        this.showAlert('warning', 'Data belum lengkap', 'Nama, NIM, dan kelas wajib diisi.')\n        return\n      }\n      this.registering = true\n      this.send({\n        payload: {\n          action: 'register',\n          data: {\n            name: this.form.name,\n            nim: this.form.nim.toUpperCase(),\n            className: this.form.className,\n            photo: this.form.photo || this.unknownPhoto,\n            logo: this.form.logo\n          }\n        }\n      })\n      clearTimeout(this.registerTimer)\n      this.registerTimer = setTimeout(() => {\n        if (!this.registering) return\n        this.registering = false\n        this.showAlert('error', 'Registrasi gagal', 'Node-RED tidak memberikan respons dalam 10 detik.')\n      }, 10000)\n    },\n    async handleBackend(payload) {\n      if (!payload?.action) return\n      if (payload.action === 'device_feedback') {\n        const status = String(payload.status || '').toUpperCase()\n        const eventId = String(payload.eventId || payload.event_id || '')\n        if (status !== 'STANDBY') return\n        if (!eventId || eventId !== this.activeAccessEventId) return\n        this.accessStatus = 'MENUNGGU'\n        this.accessUser = {}\n        this.activeAccessEventId = ''\n        return\n      }\n      if (payload.action === 'access_result' && !this.scanRequestPending) return\n      if (['registered', 'register_error'].includes(payload.action) && !this.registering) return\n      if (payload.action === 'system_error' && !this.scanRequestPending && !this.registering) return\n      if (this.isDuplicateEvent(payload)) return\n      if (payload.action === 'access_result') {\n        clearTimeout(this.scanRequestTimer)\n        this.scanRequestPending = false\n        this.releaseScanner()\n        this.accessStatus = payload.granted ? 'GRANTED' : 'DENIED'\n        this.accessUser = payload.granted ? payload.user : {}\n        this.activeAccessEventId = String(payload.eventId || '')\n        await this.$nextTick()\n        this.showAlert(\n          payload.granted ? 'success' : 'error',\n          payload.granted ? 'Akses diterima' : 'Akses ditolak',\n          payload.granted ? `Selamat datang, ${payload.user.name}` : 'QR Code tidak terdaftar atau tidak aktif.'\n        )\n        this.playAccessAudio(payload.granted)\n      }\n      if (payload.action === 'registered') {\n        clearTimeout(this.registerTimer)\n        try {\n          const qrImage = await this.createQrImage(payload.user.qrToken)\n          this.registeredStudent = { ...payload.user, qrImage }\n          this.showAlert('success', 'Registrasi berhasil', 'Kartu mahasiswa siap diunduh.')\n        } catch (error) {\n          this.showAlert('error', 'QR gagal dibuat', error.message || 'Library QR Code tidak tersedia.')\n        } finally {\n          this.registering = false\n        }\n      }\n      if (payload.action === 'register_error') {\n        clearTimeout(this.registerTimer)\n        this.registering = false\n        this.showAlert('error', 'Registrasi gagal', payload.message || 'Data tidak dapat disimpan.')\n      }\n      if (payload.action === 'system_error') {\n        clearTimeout(this.registerTimer)\n        clearTimeout(this.scanRequestTimer)\n        this.registering = false\n        this.scanRequestPending = false\n        this.releaseScanner(0)\n        this.accessStatus = 'ERROR'\n        this.accessUser = {}\n        this.showAlert('error', 'Sistem bermasalah', payload.message || 'Operasi tidak dapat diproses.')\n      }\n    },\n    showAlert(icon, title, text) {\n      if (window.Swal) {\n        Swal.fire({\n          toast: true,\n          position: 'top-end',\n          icon,\n          title,\n          text,\n          timer: 5000,\n          timerProgressBar: true,\n          showConfirmButton: false\n        })\n      }\n    },\n    isDuplicateEvent(payload) {\n      if (payload.action === 'access_result' && !payload.eventId) return true\n      if (!payload.eventId) return false\n      try {\n        const storageKey = 'qrac:lastHandledEventId'\n        if (localStorage.getItem(storageKey) === payload.eventId) return true\n        localStorage.setItem(storageKey, payload.eventId)\n      } catch (_) {\n      }\n      return false\n    },\n    async playAccessAudio(granted) {\n      const source = granted ? this.grantedAudioUrl : this.deniedAudioUrl\n      try {\n        const audio = new Audio(source)\n        audio.volume = 0.9\n        await audio.play()\n      } catch (_) {\n      }\n    },\n    async createQrImage(token) {\n      if (!(await this.waitForLibrary('QRCode'))) {\n        throw new Error('Library QR Code belum tersedia')\n      }\n      const holder = document.createElement('div')\n      holder.style.position = 'fixed'\n      holder.style.left = '-9999px'\n      document.body.appendChild(holder)\n      try {\n        new QRCode(holder, {\n          text: token,\n          width: 280,\n          height: 280,\n          colorDark: '#111827',\n          colorLight: '#ffffff',\n          correctLevel: QRCode.CorrectLevel.H\n        })\n        await new Promise(resolve => setTimeout(resolve, 80))\n        const canvas = holder.querySelector('canvas')\n        const image = holder.querySelector('img')\n        if (canvas) return canvas.toDataURL('image/png')\n        if (image?.src) return image.src\n        throw new Error('Gambar QR tidak berhasil dirender.')\n      } finally {\n        holder.remove()\n      }\n    },\n    loadImage(source) {\n      return new Promise((resolve, reject) => {\n        const image = new Image()\n        image.onload = () => resolve(image)\n        image.onerror = reject\n        image.src = source\n      })\n    },\n    async downloadCard() {\n      if (!this.registeredStudent) return\n      const student = this.registeredStudent\n      const canvas = this.$refs.cardCanvas\n      const context = canvas.getContext('2d')\n      const photo = await this.loadImage(student.photo || this.unknownPhoto)\n      const qr = await this.loadImage(student.qrImage)\n      let logo = null\n      if (student.logo) {\n        try { logo = await this.loadImage(student.logo) } catch (_) {}\n      }\n      const gradient = context.createLinearGradient(0, 0, 720, 1100)\n      gradient.addColorStop(0, '#071a38')\n      gradient.addColorStop(0.6, '#0f2f61')\n      gradient.addColorStop(1, '#124da0')\n      context.fillStyle = gradient\n      context.fillRect(0, 0, 720, 1100)\n      context.fillStyle = 'rgba(255,255,255,0.08)'\n      context.beginPath()\n      context.arc(650, 90, 220, 0, Math.PI * 2)\n      context.fill()\n      context.fillStyle = '#ffffff'\n      context.font = '700 34px Arial'\n      context.fillText('KARTU MAHASISWA', 130, 68)\n      context.font = '18px Arial'\n      context.fillText('IoT Access Control Card', 130, 99)\n      context.fillStyle = '#ffffff'\n      context.beginPath()\n      context.arc(70, 70, 38, 0, Math.PI * 2)\n      context.fill()\n      if (logo) {\n        context.save()\n        context.beginPath()\n        context.arc(70, 70, 34, 0, Math.PI * 2)\n        context.clip()\n        context.drawImage(logo, 36, 36, 68, 68)\n        context.restore()\n      } else {\n        context.fillStyle = '#124da0'\n        context.font = '700 22px Arial'\n        context.textAlign = 'center'\n        context.fillText('AC', 70, 78)\n      }\n      context.save()\n      context.beginPath()\n      context.arc(360, 285, 132, 0, Math.PI * 2)\n      context.clip()\n      context.drawImage(photo, 228, 120, 264, 330)\n      context.restore()\n      context.lineWidth = 8\n      context.strokeStyle = '#ffffff'\n      context.beginPath()\n      context.arc(360, 285, 136, 0, Math.PI * 2)\n      context.stroke()\n      context.textAlign = 'center'\n      context.fillStyle = '#ffffff'\n      context.font = '700 34px Arial'\n      context.fillText(student.name.slice(0, 28), 360, 490)\n      context.fillStyle = '#bfdbfe'\n      context.font = '700 25px Arial'\n      context.fillText(student.nim, 360, 530)\n      context.font = '20px Arial'\n      context.fillText(student.className.slice(0, 34), 360, 565)\n      context.fillStyle = '#ffffff'\n      context.fillRect(185, 605, 350, 350)\n      context.drawImage(qr, 205, 625, 310, 310)\n      context.fillStyle = '#dbeafe'\n      context.font = '700 17px Arial'\n      context.fillText('SCAN UNTUK AKSES', 360, 990)\n      context.font = '15px Arial'\n      context.fillText('IDENTITAS DIGITAL MAHASISWA', 360, 1040)\n      context.textAlign = 'left'\n      const link = document.createElement('a')\n      link.download = `kartu-${student.nim}.png`\n      link.href = canvas.toDataURL('image/png')\n      link.click()\n    }\n  },\n  mounted() {\n    this.accessStatus = 'MENUNGGU'\n    this.accessUser = {}\n    try { localStorage.removeItem('qrac:lastAccess') } catch (_) {}\n  },\n  watch: {\n    msg(message) {\n      if (message?.payload) this.handleBackend(message.payload)\n    }\n  },\n  unmounted() {\n    clearTimeout(this.scanCooldownTimer)\n    clearTimeout(this.scanRequestTimer)\n    clearTimeout(this.registerTimer)\n    this.stopScanner()\n  }\n}\n</script>\n<style>\n  .qrac-shell {\n    width: 100%;\n    box-sizing: border-box;\n    color: rgb(var(--v-theme-on-surface));\n  }\n\n  .qrac-header,\n  .qrac-section-title,\n  .qrac-actions,\n  .qrac-nav {\n    display: flex;\n    align-items: center;\n  }\n\n  .qrac-header {\n    justify-content: space-between;\n    gap: 20px;\n    margin-bottom: 18px;\n    padding: 18px 22px;\n    border-radius: 16px;\n    background: #0f172a;\n    color: #ffffff;\n  }\n\n  .qrac-header h2,\n  .qrac-header p,\n  .qrac-section-title h3,\n  .qrac-section-title p,\n  .qrac-card-preview h3 