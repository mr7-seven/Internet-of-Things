        "func": "const data = msg.payload?.data;\nconst eventMeta = () => ({\n    eventId: `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`,\n    emittedAt: new Date().toISOString()\n});\n\nif (!data || !data.name || !data.nim || !data.className) {\n    return [{\n        payload: {\n            action: \"register_error\",\n            ...eventMeta(),\n            message: \"Nama, NIM, dan kelas wajib diisi.\"\n        }\n    }, null];\n}\n\nconst clean = {\n    name: String(data.name).trim().slice(0, 80),\n    nim: String(data.nim).trim().toUpperCase().slice(0, 30),\n    className: String(data.className).trim().slice(0, 40),\n    photo: String(data.photo || \"\"),\n    logo: String(data.logo || \"\")\n};\n\nif (!/^data:image\\/(jpeg|png|webp);base64,/i.test(clean.photo) || clean.photo.length > 400000) {\n    clean.photo = \"\";\n}\n\nif (!/^data:image\\/(jpeg|png|webp);base64,/i.test(clean.logo) || clean.logo.length > 250000) {\n    clean.logo = \"\";\n}\n\nif (!/^[A-Z0-9._-]+$/.test(clean.nim)) {\n    return [{\n        payload: {\n            action: \"register_error\",\n            ...eventMeta(),\n            message: \"Format NIM hanya boleh berisi huruf, angka, titik, garis bawah, atau tanda minus.\"\n        }\n    }, null];\n}\n\nconst randomPart = Math.random().toString(36).slice(2, 10).toUpperCase();\nconst timePart = Date.now().toString(36).toUpperCase();\nconst qrToken = `${clean.nim}-${timePart}-${randomPart}`;\n\nmsg.student = {\n    ...clean,\n    qrToken\n};\n\nmsg.qracOperation = \"register\";\n\nmsg.params = {\n    $qr_token: qrToken,\n    $nim: clean.nim,\n    $name: clean.name,\n    $class_name: clean.className,\n    $photo: clean.photo\n};\n\nreturn [null, msg];\n",
