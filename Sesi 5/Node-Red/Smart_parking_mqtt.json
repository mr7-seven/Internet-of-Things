    {
        "id": "43281825352d9bff",
        "type": "function",
        "z": "21946c7b9ab388b7",
        "name": "Parking State Controller",
        "func": "const SLOT_COUNT = 10;\n\nlet state = flow.get(\"smartParkingState\");\nif (!state || !Array.isArray(state.slots) || state.slots.length !== SLOT_COUNT) {\n    state = {\n        slots: Array(SLOT_COUNT).fill(false),\n        topology: 3,\n        nodes: {},\n        lastEvent: \"Sistem diinisialisasi\"\n    };\n}\n\nlet input = msg.payload;\nif (Buffer.isBuffer(input)) input = input.toString();\nif (typeof input === \"string\") {\n    try { input = JSON.parse(input); }\n    catch (_) { input = { event: input }; }\n}\nif (!input || typeof input !== \"object\") input = {};\n\nconst topicParts = String(msg.topic || \"\").split(\"/\");\nconst topicNode = String(input.node_id || (topicParts.length >= 2 ? topicParts[1] : \"\"));\nlet action = String(input.action || input.event || \"\").toLowerCase();\n\nif (msg.topic?.endsWith(\"/status\")) {\n    action = \"node_status\";\n}\n\nconst seen = flow.get(\"smartParkingEvents\") || {};\nconst eventId = String(input.eventId || input.event_id || \"\");\nif (eventId && seen[eventId]) return null;\nif (eventId) {\n    seen[eventId] = Date.now();\n    const ids = Object.keys(seen);\n    if (ids.length > 60) ids.sort((a, b) => seen[a] - seen[b]).slice(0, ids.length - 60).forEach(id => delete seen[id]);\n    flow.set(\"smartParkingEvents\", seen);\n}\n\nconst randomItem = indexes => indexes[Math.floor(Math.random() * indexes.length)];\nconst emptyIndexes = () => state.slots.map((occupied, index) => occupied ? -1 : index).filter(index => index >= 0);\nconst busyIndexes = () => state.slots.map((occupied, index) => occupied ? index : -1).filter(index => index >= 0);\nlet publishCommand = false;\n\nif (action === \"entry\") {\n    const available = emptyIndexes();\n    if (available.length) {\n        const index = randomItem(available);\n        state.slots[index] = true;\n        state.lastEvent = `Mobil masuk → slot P${String(index + 1).padStart(2, \"0\")}`;\n    } else {\n        state.lastEvent = \"Mobil ditolak → parkir penuh\";\n    }\n    publishCommand = true;\n} else if (action === \"exit\") {\n    const occupied = busyIndexes();\n    if (occupied.length) {\n        const index = randomItem(occupied);\n        state.slots[index] = false;\n        state.lastEvent = `Mobil keluar ← slot P${String(index + 1).padStart(2, \"0\")}`;\n    } else {\n        state.lastEvent = \"Tidak ada kendaraan untuk keluar\";\n    }\n    publishCommand = true;\n} else if (action === \"set_count\") {\n    const target = Math.max(0, Math.min(SLOT_COUNT, Number(input.count) || 0));\n    const indexes = Array.from({ length: SLOT_COUNT }, (_, index) => index);\n    for (let i = indexes.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [indexes[i], indexes[j]] = [indexes[j], indexes[i]];\n    }\n    state.slots = Array(SLOT_COUNT).fill(false);\n    indexes.slice(0, target).forEach(index => state.slots[index] = true);\n    state.lastEvent = `Simulasi diatur menjadi ${target} kendaraan`;\n    publishCommand = true;\n} else if (action === \"reset\") {\n    state.slots = Array(SLOT_COUNT).fill(false);\n    state.lastEvent = \"Area parkir direset\";\n    publishCommand = true;\n} else if (action === \"set_topology\") {\n    state.topology = Number(input.topology) === 2 ? 2 : 3;\n    state.lastEvent = `Topologi ${state.topology} node dipilih`;\n} else if (action === \"node_status\" && topicNode) {\n    if (Number(input.topology) === 2 || Number(input.topology) === 3) {\n        state.topology = Number(input.topology);\n    }\n    state.nodes[topicNode] = {\n        online: input.online === true || String(input.status).toLowerCase() === \"online\",\n        rssi: Number(input.rssi) || 0,\n        updatedAt: Date.now()\n    };\n}\n\nconst occupied = state.slots.filter(Boolean).length;\nconst available = SLOT_COUNT - occupied;\nconst level = occupied < 5 ? \"GREEN\" : occupied < 10 ? \"YELLOW\" : \"RED\";\nconst buzzer = occupied === SLOT_COUNT;\n\nflow.set(\"smartParkingState\", state);\n\nconst uiMessage = {\n    payload: {\n        action: \"parking_state\",\n        slots: state.slots.map((isOccupied, index) => ({ id: index + 1, occupied: isOccupied })),\n        occupied,\n        available,\n        percent: occupied * 10,\n        level,\n        buzzer,\n        topology: state.topology,\n        nodes: state.nodes,\n        lastEvent: state.lastEvent\n    }\n};\n\nconst mqttMessage = publishCommand ? {\n    topic: \"parking/kelompok01/system/command\",\n    payload: JSON.stringify({\n        signal: level.toLowerCase(),\n        buzzer: buzzer ? \"blink\" : \"off\",\n        occupied\n    }),\n    qos: 1,\n    retain: true\n} : null;\n\nreturn [uiMessage, mqttMessage];\n",
